# syntax=docker/dockerfile:1
# Rebuild the application while retaining the upstream runtime tools.
FROM node:22-bookworm-slim AS frontend
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_LOCALE=en
RUN npm run build:static

FROM golang:1.26 AS backend
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /src/web/out ./server/webui/dist
RUN go vet ./... && go test ./... -count=1
RUN CGO_ENABLED=0 go build -tags embedui -trimpath \
    -ldflags="-s -w -X main.version=0.3.15-en.local" -o /out/artex ./cmd/artex

FROM ghcr.io/jiwoochris/artex-ko:v0.3.15-ko.1
COPY --from=backend /out/artex /app/artex
ENV ARTEX_LANG=en
